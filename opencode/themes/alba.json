  "theme": {
    "primary": { "dark": "albaLuz", "light": "albaOrange" },
    "secondary": { "dark": "albaOrange", "light": "albaPeach" },
    "accent": { "dark": "albaDusk", "light": "albaDusk" },
    "error": { "dark": "albaRouge", "light": "albaRouge" },
    "warning": { "dark": "albaPeach", "light": "albaPeach" },
