{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "albaBlack": "#151428",
    "albaGrey1": "#1c1a35",
    "albaGrey2": "#2c2a4c",
    "albaGrey3": "#3f3d66",
    "albaGrey4": "#55527f",
    "albaGrey5": "#6e6b99",
    "albaGrey6": "#8885b2",
    "albaGrey7": "#a5a3cc",
    "albaGrey8": "#c5c3e5",
    "albaDusk": "#ad9ae0",
    "albaHaze": "#ffddd1",
    "albaLuz": "#ffd284",
    "albaOrange": "#f29b6d",
    "albaPeach": "#ffd4b2",
    "albaPink": "#f29bc5",
    "albaRouge": "#ea8e88",
    "albaCoral": "#ffb6a8",
    "albaGreen": "#c5d89c",
    "albaBlue": "#a0c7e8",
    "albaWhite": "#ffffff"
