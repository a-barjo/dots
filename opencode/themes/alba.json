    "backgroundElement": { "dark": "albaGrey1", "light": "albaGrey7" },
    "border": { "dark": "albaGrey3", "light": "albaGrey5" },
    "borderActive": { "dark": "albaGrey5", "light": "albaGrey3" },
    "borderSubtle": { "dark": "albaGrey2", "light": "albaGrey6" },
    "diffAdded": { "dark": "albaGreen", "light": "albaGreen" },
    "diffRemoved": { "dark": "albaRouge", "light": "albaRouge" },
    "diffContext": { "dark": "albaGrey4", "light": "albaGrey4" },
    "diffHunkHeader": { "dark": "albaGrey4", "light": "albaGrey4" },
    "diffHighlightAdded": { "dark": "albaGreen", "light": "albaGreen" },
    "diffHighlightRemoved": { "dark": "albaRouge", "light": "albaRouge" },
    "diffAddedBg": { "dark": "albaGrey1", "light": "albaGrey7" },
    "diffRemovedBg": { "dark": "albaGrey1", "light": "albaGrey7" },
    "diffContextBg": { "dark": "albaBlack", "light": "albaGrey8" },
    "diffLineNumber": { "dark": "albaGrey5", "light": "albaGrey4" },
    "diffAddedLineNumberBg": { "dark": "albaGrey1", "light": "albaGrey7" },
    "diffRemovedLineNumberBg": { "dark": "albaGrey1", "light": "albaGrey7" },
    "markdownText": { "dark": "albaHaze", "light": "albaBlack" },
    "markdownHeading": { "dark": "albaOrange", "light": "albaOrange" },
    "markdownLink": { "dark": "albaBlue", "light": "albaBlue" },
    "markdownLinkText": { "dark": "albaDusk", "light": "albaDusk" },
    "markdownCode": { "dark": "albaLuz", "light": "albaLuz" },
    "markdownBlockQuote": { "dark": "albaGrey6", "light": "albaGrey6" },
    "markdownEmph": { "dark": "albaPeach", "light": "albaPeach" },
    "markdownStrong": { "dark": "albaLuz", "light": "albaLuz" },
    "markdownHorizontalRule": { "dark": "albaGrey4", "light": "albaGrey4" },
    "markdownListItem": { "dark": "albaOrange", "light": "albaOrange" },
    "markdownListEnumeration": { "dark": "albaDusk", "light": "albaDusk" },
    "markdownImage": { "dark": "albaBlue", "light": "albaBlue" },
    "markdownImageText": { "dark": "albaDusk", "light": "albaDusk" },
    "markdownCodeBlock": { "dark": "albaHaze", "light": "albaBlack" },
    "syntaxComment": { "dark": "albaGrey6", "light": "albaGrey6" },
    "syntaxKeyword": { "dark": "albaOrange", "light": "albaOrange" },
    "syntaxFunction": { "dark": "albaRouge", "light": "albaRouge" },
    "syntaxVariable": { "dark": "albaHaze", "light": "albaBlack" },
    "syntaxString": { "dark": "albaPeach", "light": "albaPeach" },
    "syntaxNumber": { "dark": "albaLuz", "light": "albaLuz" },
    "syntaxType": { "dark": "albaPink", "light": "albaPink" },
    "syntaxOperator": { "dark": "albaDusk", "light": "albaDusk" },
    "syntaxPunctuation": { "dark": "albaHaze", "light": "albaBlack" }
  }
}
